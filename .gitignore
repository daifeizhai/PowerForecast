.venv/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-of-*/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Original / derived data and run outputs are never tracked. Placeholders keep
# the directory layout in Git without committing data.
data/raw/*
data/interim/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep

# Local copies of upstream datasets that must never be committed.
NLR_Dataset/
