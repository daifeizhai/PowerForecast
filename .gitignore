.venv/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-of-*/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Local pip/session scratch directories created by restricted Windows shells
# (the harness cannot use the normal TEMP path, so pip falls back to the CWD).
pip-build-env-*/
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/
pip-unpack-*/
pip-modern-metadata-*/

# Original / derived data and run outputs are never tracked. Placeholders keep
# the directory layout in Git without committing data.
data/raw/*
data/interim/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep

# Local copies of upstream datasets that must never be committed.
NLR_Dataset/
